APP_NAME="Lahan Municipality Kiosk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bicte
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS – kiosk frontend served from a separate origin
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,kiosk.lahanmun.gov.np
SESSION_DOMAIN=null

# Optional AI assistant backend.  Leave blank to use rule-based engine only.
ASSISTANT_PROVIDER=local            # local | openai | ollama
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_API_KEY=
ASSISTANT_ENDPOINT=

# SMS gateway (optional, for SMS notifications)
SMS_PROVIDER=                       # sparrow | aakash | mero_sms
SMS_API_KEY=
SMS_SENDER_ID=Lahan_Mun

# Mail (admin notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@lahanmun.gov.np"
MAIL_FROM_NAME="${APP_NAME}"
