APP_NAME="Lahan Municipality Kiosk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ne_NP

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database — defaults to SQLite for zero-config dev.
# To switch to MySQL: set DB_CONNECTION=mysql and uncomment the
# MySQL block. Then create a `bicte` database and re-run migrations.
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bicte
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# CORS — kiosk frontend is usually on a different port (5173)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000,kiosk.lahanmun.gov.np

# AI assistant — leave provider blank for the rule-based engine only.
ASSISTANT_PROVIDER=local
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_API_KEY=
ASSISTANT_ENDPOINT=

# SMS gateway (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=Lahan_Mun

# Mail (admin notifications)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@lahanmun.gov.np"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
